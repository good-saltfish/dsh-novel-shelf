{
  "name": "dsh-novel-shelf",
  "version": "0.2.0",
  "description": "在 DSH 右侧栏里摸鱼看本地 txt 小说，自带《十日终焉》《我在精神病院学斩神》《我不是戏神》三本，边看小说边做项目，章节、进度和主题与桌面版 novel-reader 共用；新增 AI 陪读：开着之后 AI 每隔一段时间就着刚读到的内容吐槽一句，默认关闭。",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json",
    "docs",
    "books"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/hosttest.mjs && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "author": "good-saltfish",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "novel",
    "reader",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/good-saltfish/dsh-novel-shelf.git"
  },
  "homepage": "https://github.com/good-saltfish/dsh-novel-shelf#readme",
  "bugs": {
    "url": "https://github.com/good-saltfish/dsh-novel-shelf/issues"
  }
}