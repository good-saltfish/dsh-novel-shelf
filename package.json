{
  "name": "dsh-novel-shelf",
  "version": "0.4.1",
  "description": "DSH 右侧栏小说书架：本地 txt 三条路导入，内置 434 本公版中文书库（点下载即入架），可选 AI 陪读吐槽。A DSH right-sidebar novel shelf: import local txt three ways, a built-in 434-title public-domain Chinese library, and an optional AI reading companion.",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "catalog",
    "icon.svg",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json",
    "docs",
    "books"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/hosttest.mjs && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "author": "good-saltfish",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "novel",
    "reader",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/good-saltfish/dsh-novel-shelf.git"
  },
  "homepage": "https://github.com/good-saltfish/dsh-novel-shelf#readme",
  "bugs": {
    "url": "https://github.com/good-saltfish/dsh-novel-shelf/issues"
  }
}
