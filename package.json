{
  "name": "dsh-novel-shelf",
  "version": "0.3.0",
  "description": "在 DSH 右侧栏看本地 txt 小说：选文件 / 浏览目录 / 填路径三种方式加书，AI 伴读边读边吐槽：定时就着刚读到的内容说一句，也能随时点「现在就说」，四种风格可选，右下角常驻陪读人物与气泡；模型可在 DSH 已注册的 provider 里挑，也能自填 OpenAI 兼容端点与 API key，默认关闭。书架自带三本小说开箱即读，章节、进度与主题和桌面版 novel-reader 共用。",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json",
    "docs",
    "books"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/hosttest.mjs && node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "author": "good-saltfish",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "novel",
    "reader",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/good-saltfish/dsh-novel-shelf.git"
  },
  "homepage": "https://github.com/good-saltfish/dsh-novel-shelf#readme",
  "bugs": {
    "url": "https://github.com/good-saltfish/dsh-novel-shelf/issues"
  }
}